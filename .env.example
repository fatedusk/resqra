# ==============================================================================
# ResQra Environment Configuration Example
# ==============================================================================

# Server Port
PORT=3001

# Supabase Configuration (Optional - ResQra includes local resilient persistence out of the box)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Configuration (Optional - Defaults to Intelligent Deterministic Rescue Agent if omitted)
# Google Gemini API Key for Vision Image Verification & Tool Calling
GEMINI_API_KEY=your-gemini-api-key

# Alternative: OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# Map Provider (Optional - Leaflet OpenStreetMap tiles work out of the box without keys)
MAP_PROVIDER=osm
